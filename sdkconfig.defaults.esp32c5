# ESP32-C5 SDIO transport defaults. C5 has a BLE controller, so the base
# sdkconfig.defaults Bluetooth settings (BT_ENABLED + BT_CONTROLLER_ONLY) apply.
CONFIG_WLH_TRANSPORT_SDIO=y
CONFIG_WLH_SDIO_HIGH_SPEED=y
CONFIG_WLH_SDIO_TIMING_PSEND_PSAMPLE=y
CONFIG_WLH_SDIO_TX_QUEUE_DEPTH=16
CONFIG_WLH_SDIO_RX_BUFFER_COUNT=8
CONFIG_ESP_WIFI_TX_BA_WIN=32
