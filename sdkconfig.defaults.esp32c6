# ESP32-C6 SDIO transport defaults.
CONFIG_WLH_TRANSPORT_SDIO=y
CONFIG_WLH_SDIO_HIGH_SPEED=y
CONFIG_WLH_SDIO_TIMING_PSEND_PSAMPLE=y
CONFIG_WLH_SDIO_TX_QUEUE_DEPTH=8
CONFIG_WLH_SDIO_RX_BUFFER_COUNT=8
# Bluetooth controller-only (VHCI) for the Bluetooth Controller service.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_LE_HCI_INTERFACE_USE_RAM=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# The BLE controller pushes the app image past 1 MB; C6 modules ship with at
# least 4 MB flash, so use the 1.5 MB single-app layout.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
