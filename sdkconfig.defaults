# WL-hosted Coprocessor defaults shared by all ESP-IDF targets.
# Bluetooth controller-only for the Bluetooth Controller service.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
# Both supported targets use the shared OTA partition layout on 4 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"
# 1 ms OSAL monotonic resolution and heartbeat accuracy.
CONFIG_FREERTOS_HZ=1000
